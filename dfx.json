{
  "version": 1,
  "canisters": {
    "cross_chain_service": {
      "type": "rust",
      "package": "cross_chain_service",
      "candid": "canisters/cross_chain_service/cross_chain_service.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "cross_chain_service"
      ]
    },
    "evm_rpc": {
      "type": "rust",
      "package": "evm_rpc",
      "candid": "canisters/evm_rpc/evm_rpc.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "evm_rpc"
      ]
    },
    "btc_signer_psbt": {
      "type": "custom",
      "candid": "constitutional-anchor/btc_signer_psbt/btc_signer_psbt.did",
      "build": [
        "cargo build --manifest-path constitutional-anchor/Cargo.toml --target wasm32-unknown-unknown --release -p btc_signer_psbt"
      ],
      "wasm": "constitutional-anchor/target/wasm32-unknown-unknown/release/btc_signer_psbt.wasm"
    },
    "proof_of_state": {
      "type": "rust",
      "package": "proof_of_state",
      "candid": "canisters/proof_of_state/proof_of_state.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "proof_of_state"
      ]
    },
    "proof_of_state_v2": {
      "type": "rust",
      "package": "proof_of_state_v2",
      "candid": "canisters/proof_of_state_v2/proof_of_state_v2.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "proof_of_state_v2"
      ]
    },
    "solana_signer_ed25519": {
      "type": "rust",
      "package": "solana_signer_ed25519",
      "candid": "canisters/solana_signer_ed25519/solana_signer_ed25519.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "solana_signer_ed25519"
      ]
    },
    "reputation_qube": {
      "type": "rust",
      "package": "reputation_qube",
      "candid": "canisters/reputation_qube/reputation_qube.did",
      "build": [
        "cargo",
        "build",
        "--target",
        "wasm32-unknown-unknown",
        "--release",
        "-p",
        "reputation_qube"
      ]
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": [
        "https://ic0.app"
      ],
      "type": "persistent"
    },
    "testnet": {
      "providers": [
        "https://testnet.dfinity.network"
      ],
      "type": "persistent"
    }
  },
  "output_env_file": ".env"
}