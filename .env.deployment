# QCT Contract Deployment Environment Variables
# Copy this file to .env and fill in your actual values

# Your private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# API Keys for verification (get from respective platforms)
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# Multisig wallet addresses for each chain (replace with your actual multisig addresses)
SEPOLIA_MULTISIG=0x0000000000000000000000000000000000000000
AMOY_MULTISIG=0x0000000000000000000000000000000000000000
ARBITRUM_MULTISIG=0x0000000000000000000000000000000000000000
BASE_MULTISIG=0x0000000000000000000000000000000000000000
OPTIMISM_MULTISIG=0x0000000000000000000000000000000000000000

# RPC URLs (these are public testnets, no API keys needed)
SEPOLIA_RPC=https://rpc.sepolia.org
AMOY_RPC=https://rpc-amoy.polygon.technology
ARBITRUM_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_RPC=https://sepolia.base.org
OPTIMISM_RPC=https://sepolia.optimism.io

# After deployment, these will be populated with actual contract addresses
NEXT_PUBLIC_QCT_CONTRACT_ETHEREUM_SEPOLIA=
NEXT_PUBLIC_QCT_CONTRACT_POLYGON_AMOY=
NEXT_PUBLIC_QCT_CONTRACT_ARBITRUM_SEPOLIA=
NEXT_PUBLIC_QCT_CONTRACT_BASE_SEPOLIA=
NEXT_PUBLIC_QCT_CONTRACT_OPTIMISM_SEPOLIA=

# Staking contract addresses (deployed after QCT contracts)
NEXT_PUBLIC_QCT_STAKING_ETHEREUM_SEPOLIA=
NEXT_PUBLIC_QCT_STAKING_POLYGON_AMOY=
NEXT_PUBLIC_QCT_STAKING_ARBITRUM_SEPOLIA=
NEXT_PUBLIC_QCT_STAKING_BASE_SEPOLIA=
NEXT_PUBLIC_QCT_STAKING_OPTIMISM_SEPOLIA=
